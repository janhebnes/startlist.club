<?xml version="1.0" encoding="utf-8" ?>
<!-- This is a config include for removing the production values from the source code repository -->
<!--
  Twilio SMS login (local development only; never commit real values):
  - Regional mode: TwilioAccountSid (AC...), TwilioFromNumber, TwilioRegion (e.g. ie1), TwilioEdge (dublin for ie1),
    TwilioApiKeySid (SK...) and TwilioApiKeySecret, with the API key created in that region.
  - Legacy US1 mode: TwilioAccountSid, TwilioAuthToken and TwilioFromNumber, with TwilioRegion and the API key fields empty.
  If any required field for the chosen mode is empty, SMS login is hidden.
-->
<serviceCredentials 
    FacebookAppId="" 
    FacebookAppSecret="" 
    
    GoogleClientId="" 
    GoogleClientSecret=""
    
    MicrosoftClientId=""
    MicrosoftClientSecret=""

    TwilioAccountSid=""
    TwilioAuthToken=""
    TwilioFromNumber=""
    TwilioRegion=""
    TwilioEdge=""
    TwilioApiKeySid=""
    TwilioApiKeySecret=""
    />